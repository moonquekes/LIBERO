(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the round steel plate and place it gently in the blue bin)
    (:regions
      (red_bin_region
          (:target main_table)
          (:ranges (
              (-0.25 0.16 -0.23 0.18)
            )
          )
      )
      (blue_bin_region
          (:target main_table)
          (:ranges (
              (-0.04 0.16 -0.02 0.18)
            )
          )
      )
      (yellow_bin_region
          (:target main_table)
          (:ranges (
              (-0.145 -0.055 -0.125 -0.035)
            )
          )
      )
      (rectangular_workpiece_slot
          (:target main_table)
          (:ranges (
              (-0.3450 -0.3100 -0.2950 -0.2600)
            )
          )
      )
      (round_workpiece_slot
          (:target main_table)
          (:ranges (
              (-0.1800 -0.3100 -0.1300 -0.2600)
            )
          )
      )
      (triangular_workpiece_slot
          (:target main_table)
          (:ranges (
              (-0.0150 -0.3100 0.0350 -0.2600)
            )
          )
      )
      (contain_region
          (:target red_bin_1)
      )
      (contain_region
          (:target blue_bin_1)
      )
      (contain_region
          (:target yellow_bin_1)
      )
      (preset_region
          (:target red_bin_1)
      )
      (preset_region
          (:target blue_bin_1)
      )
      (preset_region
          (:target yellow_bin_1)
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    steel_plate_1 steel_plate_2 - steel_plate
    steel_plate_round_1 steel_plate_round_2 - steel_plate_round
    steel_plate_triangle_1 steel_plate_triangle_2 - steel_plate_triangle
    red_bin_1 - red_bin
    blue_bin_1 - blue_bin
    yellow_bin_1 - yellow_bin
  )

  (:obj_of_interest
    steel_plate_round_1
    blue_bin_1
  )

  (:init
    (On red_bin_1 main_table_red_bin_region)
    (On blue_bin_1 main_table_blue_bin_region)
    (On yellow_bin_1 main_table_yellow_bin_region)
    (On steel_plate_1 main_table_rectangular_workpiece_slot)
    (On steel_plate_round_1 main_table_round_workpiece_slot)
    (On steel_plate_triangle_1 main_table_triangular_workpiece_slot)
    (In steel_plate_2 red_bin_1_preset_region)
    (In steel_plate_round_2 blue_bin_1_preset_region)
    (In steel_plate_triangle_2 yellow_bin_1_preset_region)
  )

  (:goal
    (And (In steel_plate_round_1 blue_bin_1_contain_region))
  )

)
